generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Student {
  id              String           @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  rollNo          String           @unique
  email           String           @unique
  password        String           // Date of birth in DDMMYYYY format
  dateOfBirth     String           // Date of birth in DD/MM/YYYY format (used as password)
  class           String
  parentName      String
  phone           String
  status          Status           @default(ACTIVE)
  academicYear    String
  promotionStatus PromotionStatus  @default(PENDING)
  academicRecords AcademicRecord[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([class])
  @@index([academicYear])
  @@map("students")
}

type AcademicRecord {
  year       String
  class      String
  term       String
  subjects   SubjectMark[]
  enteredBy  String
  enteredAt  DateTime
  status     String // "draft" or "published"
}

type SubjectMark {
  subjectCode String
  marks       Float
  maxMarks    Int
}

enum Status {
  ACTIVE
  INACTIVE
}

enum PromotionStatus {
  PROMOTED
  DETAINED
  PENDING
}

model Teacher {
  id                 String                  @id @default(auto()) @map("_id") @db.ObjectId
  name               String
  email              String                  @unique
  password           String                  // Email ID (same as email, to be reset on first login)
  phone              String
  classSubjectPairs  ClassSubjectPair[]
  isAdmin            Boolean                 @default(false)
  firstLogin         Boolean                 @default(true) // Track if password needs to be reset
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  // Relations
  adminLogs       AdminLog[]
  reportPublishes ReportPublish[]

  @@map("teachers")
}

type ClassSubjectPair {
  subject       String
  classAssigned String
}

model Subject {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  maxMarks     Int
  passingMarks Int
  academicYear String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([name, academicYear])
  @@map("subjects")
}

model AcademicYear {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  year      String   @unique
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("academic_years")
}

model ReportPublish {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  class        String
  term         String
  academicYear String
  isPublished  Boolean  @default(false)
  publishedAt  DateTime?
  publishedById String?  @db.ObjectId
  publishedBy  Teacher? @relation(fields: [publishedById], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([class, term, academicYear])
  @@map("report_publish")
}

model AdminLog {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  adminId     String   @db.ObjectId
  admin       Teacher  @relation(fields: [adminId], references: [id])
  action      String   // e.g., "CREATE_STUDENT", "UPDATE_TEACHER", "DELETE_SUBJECT", "PUBLISH_REPORT"
  entityType  String   // e.g., "Student", "Teacher", "Subject", "Report"
  entityId    String?  // ID of the affected entity
  description String   // Human-readable description
  metadata    Json?    // Additional data like old/new values
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([adminId])
  @@index([action])
  @@index([createdAt])
  @@map("admin_logs")
}
