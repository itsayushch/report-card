generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Student {
  id              String           @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  regNo           String           @unique @map("regNo")
  password        String?          @map("password") // Maps to password field in DB, optional for backward compatibility
  class           String
  status          Status           @default(ACTIVE)
  academicYear    String
  secondLanguageSubject String?
  thirdLanguageSubject  String?
  sixthSubject          String?
  valueFaithSubject     String?
  promotionStatus PromotionStatus  @default(PENDING)
  createdAt       String
  updatedAt       String

  // Relations
  academicRecords AcademicRecord[] // Relation to separate collection

  @@index([class])
  @@index([status])
  @@index([academicYear])
  @@index([class, status])
  @@index([name])
  @@map("students")
}

// Bucket Pattern: One document per student per academic year
model AcademicRecord {
  id           String       @id @default(auto()) @map("_id") @db.ObjectId
  studentId    String       @db.ObjectId
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYear String
  class        String
  terms        TermRecord[] // Array of terms for this year
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([studentId, academicYear]) // One record per student per year
  @@index([studentId])
  @@index([academicYear])
  @@index([class])
  @@map("academic_records")
}

type TermRecord {
  name            String        // e.g., "1st Unit Test", "Mid Term"
  subjects        SubjectMark[]
  enteredBy       String
  enteredAt       DateTime
  published       Boolean       @default(false)
  teacherRemarks  String?       // Class teacher remarks (only for first 3 terms)
}

type SubjectMark {
  subjectCode String
  marks       Float
  maxMarks    Int
  grade       String? // For alphabetical grading (A/B/C)
}

enum Status {
  ACTIVE
  INACTIVE
}

enum PromotionStatus {
  PROMOTED
  DETAINED
  PENDING
}

model Teacher {
  id                 String                  @id @default(auto()) @map("_id") @db.ObjectId
  name               String
  email              String                  @unique
  password           String                  // Email ID (same as email, to be reset on first login)
  profilePicture     String?                 // Profile image path or URL
  classSubjectPairs  ClassSubjectPair[]
  isAdmin            Boolean                 @default(false)
  isSuperAdmin       Boolean                 @default(false) // Only one superadmin allowed
  firstLogin         Boolean                 @default(true) // Track if password needs to be reset
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  // Relations
  adminLogs          AdminLog[]
  reportPublishes    ReportPublish[]
  classTeacherAssignments ClassTeacher[]

  @@map("teachers")
}

type ClassSubjectPair {
  subject       String
  classAssigned String
}


model AcademicYear {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  year      String   @unique
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("academic_years")
}

model ReportPublish {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  class        String
  term         String
  academicYear String
  isPublished  Boolean  @default(false)
  publishedAt  DateTime?
  publishedById String?  @db.ObjectId
  publishedBy  Teacher? @relation(fields: [publishedById], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([class, term, academicYear])
  @@map("report_publish")
}

model AdminLog {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  adminId     String   @db.ObjectId
  admin       Teacher  @relation(fields: [adminId], references: [id])
  action      String   // e.g., "CREATE_STUDENT", "UPDATE_TEACHER", "DELETE_SUBJECT", "PUBLISH_REPORT"
  entityType  String   // e.g., "Student", "Teacher", "Subject", "Report"
  entityId    String?  // ID of the affected entity
  description String   // Human-readable description
  metadata    Json?    // Additional data like old/new values
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([adminId])
  @@index([action])
  @@index([createdAt])
  @@map("admin_logs")
}

model ClassTeacher {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  teacherId    String   @db.ObjectId
  teacher      Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  class        String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([class])
  @@index([teacherId])
  @@map("class_teachers")
}
